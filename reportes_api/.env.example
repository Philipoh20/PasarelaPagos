# ==============================================================================
# Este microservicio reutiliza el JWT_SECRET_KEY del .env principal
# (PasarelaPagos/.env), por eso aquí solo se configura lo propio de
# este servicio de Reportes.
# ==============================================================================

# URL base donde corre el servicio principal de Pagos/Facturas
PASARELA_BASE_URL=http://127.0.0.1:5000

# Puerto en el que corre este servicio de Reportes
PORT=5001
