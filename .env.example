# ==============================================================================
# CONFIGURACIÓN DE SEGURIDAD Y JWT (DESPLIEGUE EN PRODUCCIÓN)
# ==============================================================================
APP_ENV=production
# Genera una clave secreta segura de al menos 32 caracteres para la firma de tokens JWT
JWT_SECRET_KEY=cambia_esta_clave_por_una_secreta_y_segura_de_mas_de_32_caracteres
JWT_EXPIRATION_HOURS=2

# ==============================================================================
# CREDENCIALES DEL PRIMER ADMINISTRADOR (INICIALIZACIÓN DEL SISTEMA)
# ==============================================================================
ADMIN_USERNAME=admin_sistema
ADMIN_PASSWORD=contrasena_segura_para_el_administrador_2026
ADMIN_EMAIL=administrador@tuorganizacion.com

# ==============================================================================
# BASE DE DATOS
# ==============================================================================
BD_NAME=main.db

# ==============================================================================
# API DE DIVISAS
# ==============================================================================
DIVISAS_API_URL=https://open.er-api.com/v6/latest/{BASE}
DIVISAS_CACHE_SEGUNDOS=3600
DIVISAS_TIMEOUT=5

